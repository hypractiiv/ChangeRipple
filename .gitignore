# ChangeRipple Root .gitignore

# Node / Frontend
node_modules/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# Java / Maven
target/
*.class
*.jar
*.war
*.ear
.mvn/wrapper/maven-wrapper.jar
.project
.classpath
.settings/
.idea/
*.iml
*.iws
*.ipr
nbproject/
nb-configuration.xml

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Environment and Secrets
*.env
*.env.local
.env.development.local
.env.test.local
.env.production.local
!*.env.example

# Logs
logs/
*.log

# Test and Coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# Temp
temp/
tmp/
