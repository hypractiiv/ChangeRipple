# ChangeRipple Backend Environment Configuration

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=mysql

# MySQL Database
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/changeripple?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=rootpassword
